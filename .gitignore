clean_output_data_raw_active.csv
ml_ready_data_raw.csv
ml_ready_data_raw_active.csv
combined_apstats.txt

# Ignore CSV files by default
*.csv

# ==================================================
# Generated model files: ignore by default
# ==================================================
*.pt
*.pth
*.pkl
*.pickle
*.npy

# ==================================================
# Allow important trained models and supporting files
# ==================================================
!models/ae_active_model.pt
!models/ae_idle_model.pt
!models/if_active_model.pkl
!models/if_idle_model.pkl
!models/scaler_active.pkl
!models/scaler_idle.pkl
!models/threshold_active.npy
!models/threshold_idle.npy
!models/model_metadata.json

# ==================================================
# Generated experiment results
# ==================================================
results/**/*.csv
results/**/*.txt
results/**/*.json

# ==================================================
# Build and distribution files
# ==================================================
build/
dist/